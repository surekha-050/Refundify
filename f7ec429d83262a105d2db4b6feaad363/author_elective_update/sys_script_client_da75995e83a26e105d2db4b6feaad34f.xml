        <script><![CDATA[function onSubmit() {
  var errors = [];


  var email = g_form.getValue('email');
  var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(email) || email.length > 255) {
    errors.push("Provide a valid Email under 255 characters");
  }


  
  if (g_form.getValue('contact number') === '' || g_form.getValue('contact_number').length == 10) {
    errors.push("contact number is  must be 10 characters");
  }

  if (g_form.getValue('ifsc_code') === '' || g_form.getValue('ifsc_code').length > 255) {
    errors.push("IFSC Code is required and must be under 255 characters");
  }

  
  if ((g_form.getValue('action') === 'reject' || g_form.getValue('action') === 'send_back') &&
      (g_form.getValue('approver_note') === '' || g_form.getValue('approver_note').length > 4000)) {
    errors.push("Approver Note is required when rejecting or sending back");
  }

  
  if (g_form.getValue('action') === 'cancel' && g_form.getValue('cancel_comment') === '') {
    errors.push("Comment is required to cancel a request");
  }

  if (errors.length > 0) {
  g_form.addInfoMessage("Please fix the following errors:\n" + errors.join("\n"));
  return false;
}
return true; 
}
]]></script>
