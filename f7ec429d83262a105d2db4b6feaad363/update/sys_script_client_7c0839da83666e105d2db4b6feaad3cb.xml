        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
    if (newValue) {
        var selectedDate = new Date(newValue);
        var now = new Date();
 
        if (selectedDate > now) {
            g_form.showFieldMsg('date_of_purchase','date cannot be in the future.','error');
            return false;
        }
    }
 
    return true;
   
}]]></script>
